import random

def get_player_choice():
    player_choice = str(input("Enter rock, paper, or scissors: ")).lower()

    while player_choice not in ["rock", "paper", "scissors"]:
        print(f"Sorry {player_choice} is not a real answer bro")
        player_choice = str(input("Enter rock, paper, or scissors: ")).lower()
    
    return player_choice
    
def determine_winner(PC, CC):
   if PC == CC:
    game_result = "Tie"
   elif winning_moves[PC] == CC:
    game_result = "Win"
   else:
    game_result = "Lose"

   return game_result



computer_wins = 0
player_wins = 0
options = ["rock", "paper", "scissors"]
winning_moves = {
    "rock": "scissors",
    "paper": "rock",
    "scissors": "paper"
}


print("Welcome to Rock, Paper, Scissors!")

round_num = int(input("How many rounds do you want to play? (Odd number): "))

while (round_num % 2 == 0): 
    print("Please enter an odd number of rounds!")
    round_num = int(input("How many rounds do you want to play? (Odd number): "))


while (computer_wins + player_wins) < round_num:
   player_choice = get_player_choice()
   computer_choice = random.choice(options)
   game_result = determine_winner(player_choice, computer_choice)
   
   if game_result == "Win":
      print(f"You won!\n Computer chose {computer_choice}")
      player_wins +=1 
   elif game_result =="Lose":
      print(f"You Lost!\n Computer chose {computer_choice}")
      computer_wins +=1 
   elif game_result =="Tie":
      print("Tie! Doesnt count!")




print("----------------------------")
print(f"Score -- You: {player_wins} | Computer: {computer_wins}")
if player_wins > computer_wins:
    print("You Won!")
else:
   print("You Lost")
